# Maintainer template: replace pkgver and sha256sums after publishing a release.
pkgname=helios-agent
pkgver=0.1.0
pkgrel=1
pkgdesc='Bounded, provider-neutral Helios coding agent'
arch=('x86_64')
url='https://github.com/Shidori5417/helios-agent'
license=('MIT')
depends=()
source=("helios-agent-${pkgver}.tar.gz::https://github.com/Shidori5417/helios-agent/archive/v${pkgver}.tar.gz")
# Generate with: sha256sum helios-agent-${pkgver}.tar.gz
sha256sums=('REPLACE_WITH_RELEASE_SHA256')

build() {
  cd "${srcdir}/helios-agent-${pkgver}"
  cargo build --release --locked --offline
}

package() {
  cd "${srcdir}/helios-agent-${pkgver}"
  install -Dm755 target/release/helios "${pkgdir}/usr/bin/helios"
  install -Dm755 target/release/agent-cli "${pkgdir}/usr/bin/agent-cli"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
